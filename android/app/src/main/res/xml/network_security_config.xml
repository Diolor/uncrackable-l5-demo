<?xml version="1.0" encoding="utf-8"?>
<!-- System trust anchors only: a user-installed CA is never trusted. No cleartext anywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
